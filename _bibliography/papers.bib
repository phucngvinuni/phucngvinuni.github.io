}

@article{nguyen2026aquasc,
  abbr={IEEE TETCI},
  bibtex_show={true},
  title={AquaSC: Task-Oriented Semantic Communication for Efficient and Intelligent IoT Systems},
  author={Nguyen, H.-P. and Nguyen, T. T. and Wanasekara, S. H. and Ngo, N. M. and Dzung, D. V. and Nguyen, Van-Dinh},
  abstract={Resource-constrained Internet of Things (IoT) deployments demand high bandwidth efficiency and ultra-low latency. We introduce AquaSC, a task-oriented semantic communication framework tailored for distributed intelligent IoT networks. AquaSC extracts task-relevant semantic features and transmits them through deep joint source-channel coding (DeepJSCC), significantly reducing transmission overhead while preserving downstream inference accuracy under noisy channel conditions.},
  journal={IEEE Transactions on Emerging Topics in Computational Intelligence},
  year={2026},
  note={Major Revision},
  selected={true}
}

