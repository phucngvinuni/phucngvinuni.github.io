}

@inproceedings{nguyen2026chronosc,
  abbr={IEEE ICCE},
  bibtex_show={true},
  title={ChronoSC: Task-Oriented Semantic Communication via Temporal-to-Color Encoding},
  author={Nguyen, P. H. and Nguyen, T. T. and Duong, Q. N. and Nguyen, Van-Dinh},
  abstract={Task-oriented semantic communication (SC) is a promising paradigm to address bandwidth constraints and latency bottlenecks in video-based tasks such as Video Question Answering (VideoQA). We propose ChronoSC, a lightweight framework utilizing Chrono-Color Stacking to collapse video temporal dynamics into a single static image for efficient DeepJSCC transmission and direct consumption by pre-trained vision-language models.},
  booktitle={2026 IEEE 11th International Conference on Communications and Electronics (ICCE)},
  year={2026},
  month={May},
  arxiv={2605.16388},
  html={https://arxiv.org/abs/2605.16388},
  preview={chronosc.png},
  note={Accepted}
}

@article{nguyen2026fisher,
  abbr={IEEE TCSV},
  bibtex_show={true},
  title={FISHER: Gradient-Decoupled Hierarchical Multi-Task Learning for Fine-Grained Aquatic Species Recognition},
  author={Nguyen, H.-P. and Ngo, B. H. and Tran, M. P. and Nguyen, Van-Dinh},
  abstract={Fine-grained aquatic species recognition is inherently challenging due to extreme phenotypic similarities among related species and severe class imbalance in real-world distributions. In this paper, we propose FISHER, a gradient-decoupled hierarchical multi-task learning framework coordinating segmentation, morphological trait identification, and fine-grained classification. By decoupling conflicting task gradients and aligning trait prototypes, FISHER achieves state-of-the-art accuracy and significant gains on ultra-rare species.},
  journal={IEEE Transactions on Circuits and Systems for Video Technology},
  year={2026},
  month={July},
  note={Major Revision},
  arxiv={2607.20523},
  html={https://arxiv.org/abs/2607.20523},
  code={https://github.com/phucngvinuni/FISHER},
  website={https://phucngvinuni.github.io/FISHER/},
  preview={fisher.png},
  selected={true}
}

@misc{nguyen2026cmambapose,
  abbr={Arxiv},
  bibtex_show={true},
  title={C-MambaPose: A Physics-Informed Complex Mamba Framework for Cross-Environment WiFi Human Pose Estimation},
  author={Nguyen, Phuc H.},
  abstract={Cross-environment WiFi-based human pose estimation (HPE) suffers from severe domain shift caused by environmental multipath variations. We introduce C-MambaPose, a physics-informed complex Mamba framework that processes complex-valued Channel State Information (CSI) by decoupling phase and amplitude dynamics with complex state space models to achieve robust cross-environment 3D pose estimation.},
  year={2026},
  arxiv={2606.13700},
  html={https://arxiv.org/abs/2606.13700},
  preview={cmambapose.png},
  note={Arxiv preprint}
}
