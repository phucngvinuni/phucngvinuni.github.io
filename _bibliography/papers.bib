@inproceedings{nguyen2027semposefi,
  abbr={IEEE INFOCOM},
  bibtex_show={true},
  title={SemPose-Fi: Label-Free Cross-Environment Wi-Fi Pose Estimation via Semantic CSI Transmission},
  author={Nguyen, P. H. and Gian, Toan and Nguyen, Van-Dinh},
  abstract={Cross-environment Wi-Fi-based human pose estimation encounters severe domain shifts caused by complex multipath reflections. We propose SemPose-Fi, a novel label-free cross-environment framework that extracts semantic CSI features invariant to multipath variations, enabling accurate 3D human pose reconstruction across unseen environments without target-domain calibration or manual labels.},
  booktitle={IEEE International Conference on Computer Communications (INFOCOM)},
  year={2027},
  note={Under review},
  selected={true}
}

@misc{nguyen2026cmambapose,
  abbr={Arxiv},
  bibtex_show={true},
  title={C-MambaPose: A Physics-Informed Complex Mamba Framework for Cross-Environment WiFi Human Pose Estimation},
  author={Nguyen, Phuc H.},
  abstract={Cross-environment WiFi-based human pose estimation (HPE) suffers from severe domain shift caused by environmental multipath variations. We introduce C-MambaPose, a physics-informed complex Mamba framework that processes complex-valued Channel State Information (CSI) by decoupling phase and amplitude dynamics with complex state space models to achieve robust cross-environment 3D pose estimation.},
  year={2026},
  arxiv={2606.13700},
