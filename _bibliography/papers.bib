  bibtex_show={true},
  title={FISHER: Gradient-Decoupled Hierarchical Multi-Task Learning for Fine-Grained Recognition},
  author={Nguyen, H.-P. and Ngo, B. H. and Tran, M. P. and Nguyen, Van-Dinh},
  abstract={Fine-grained recognition is inherently challenging due to extreme phenotypic similarities among related classes and severe class imbalance in real-world distributions. In this paper, we propose FISHER, a gradient-decoupled hierarchical multi-task learning framework coordinating segmentation, morphological trait identification, and fine-grained classification. By decoupling conflicting task gradients and aligning trait prototypes, FISHER achieves state-of-the-art accuracy and significant gains on ultra-rare categories.},
